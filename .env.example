# Fernet encryption key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-fernet-key-here

# Database path (inside Docker volume)
DB_PATH=/data/finance.db

# === Port Allocation (Project #6, base 10610) ===
# API (FastAPI/uvicorn) — exposed on host
FT_PORT_API=10611
# Web (Next.js) — docker compose prod
FT_PORT_WEB=10613
# Web (Next.js) — npm run dev (local, fast reload) uses 10614 (set in web/package.json)

# === Convex Auth (set as Convex env vars via dashboard or CLI) ===
# AUTH_GOOGLE_ID=your-google-oauth-client-id
# AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
# SITE_URL=http://localhost:10614
# JWT_PRIVATE_KEY=<generated RS256 private key>
# JWKS=<generated RS256 public key in JWKS format>
#
# Generate keys: node -e "import('jose').then(async({exportJWK,exportPKCS8,generateKeyPair})=>{const k=await generateKeyPair('RS256');console.log(await exportPKCS8(k.privateKey));console.log(JSON.stringify({keys:[{use:'sig',...await exportJWK(k.publicKey)}]}))})"